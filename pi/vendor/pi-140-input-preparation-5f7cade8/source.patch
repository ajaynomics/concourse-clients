diff --git a/scripts/bundle-notices.mjs b/scripts/bundle-notices.mjs
new file mode 100644
index 000000000..49637eb0f
--- /dev/null
+++ b/scripts/bundle-notices.mjs
@@ -0,0 +1,64 @@
+import { createHash } from "node:crypto";
+import { existsSync, readFileSync, readdirSync, realpathSync, statSync, writeFileSync } from "node:fs";
+import { dirname, join, relative, resolve } from "node:path";
+
+/** Preserve complete dependency licenses as well as esbuild's extracted legal comments. */
+export function writeBundleNotices(repoRoot, metafiles, outputPath) {
+	const overrideDirectory = join(repoRoot, "packages/coding-agent/LICENSES");
+	const overrides = JSON.parse(readFileSync(join(overrideDirectory, "notice-overrides.json"), "utf8"));
+	const packageRoots = new Set();
+	for (const metafile of metafiles) {
+		for (const input of Object.keys(metafile.inputs)) {
+			if (!input.includes("node_modules/")) continue;
+			let directory = dirname(realpathSync(resolve(repoRoot, input)));
+			while (true) {
+				const metadata = join(directory, "package.json");
+				if (existsSync(metadata)) {
+					const pkg = JSON.parse(readFileSync(metadata, "utf8"));
+					// dist/package.json often specifies only module format, not a package identity.
+					if (typeof pkg.name === "string" && typeof pkg.version === "string") break;
+				}
+				const parent = dirname(directory);
+				if (parent === directory) throw new Error(`No package metadata for bundled input: ${input}`);
+				directory = parent;
+			}
+			packageRoots.add(directory);
+		}
+	}
+	const sections = [];
+	const missing = [];
+	for (const directory of [...packageRoots].sort()) {
+		const pkg = JSON.parse(readFileSync(join(directory, "package.json"), "utf8"));
+		const notices = readdirSync(directory).filter((name) => /^(licen[cs]e|copying|notice)([.-]|$)/i.test(name));
+		const files = notices.flatMap((name) => {
+			const path = join(directory, name);
+			return statSync(path).isDirectory()
+				? readdirSync(path, { recursive: true }).map((child) => join(path, child)).filter((child) => statSync(child).isFile())
+				: [path];
+		});
+		const override = overrides[`${pkg.name}@${pkg.version}`];
+		if (files.length === 0 && !override?.files.length) {
+			missing.push(`${pkg.name}@${pkg.version} (${pkg.repository?.url}, ${pkg.license})`);
+		}
+		sections.push(`## ${pkg.name}@${pkg.version} (${pkg.license ?? "see license"})\n`);
+		for (const file of files.sort()) sections.push(`### ${relative(directory, file)}\n\n${readFileSync(file, "utf8")}\n`);
+		if (override) {
+			sections.push(`Recovered upstream notices: ${JSON.stringify(override, null, 2)}\n`);
+			for (const notice of override.files) {
+				const bytes = readFileSync(join(overrideDirectory, notice.file));
+				if (createHash("sha256").update(bytes).digest("hex") !== notice.sha256) {
+					throw new Error(`Notice digest mismatch: ${pkg.name}@${pkg.version}/${notice.file}`);
+				}
+				sections.push(`### ${notice.file}\n\n${bytes.toString("utf8")}\n`);
+			}
+		}
+	}
+	if (missing.length > 0) throw new Error(`Missing bundled licenses:\n${missing.join("\n")}`);
+	for (const file of [
+		"packages/mcp/LICENSES/modelcontextprotocol-typescript-sdk.txt",
+		"packages/coding-agent/LICENSES/highlight.js-11.9.0.txt",
+		"packages/coding-agent/LICENSES/marked-18.0.5.txt",
+	]) sections.push(`## ${file}\n\n${readFileSync(join(repoRoot, file), "utf8")}\n`);
+	writeFileSync(outputPath, `# Bundled third-party notices\n\n${sections.join("\n")}\n`);
+	console.log(`Preserved licenses for ${packageRoots.size} bundled dependency packages in ${relative(repoRoot, outputPath)}`);
+}
