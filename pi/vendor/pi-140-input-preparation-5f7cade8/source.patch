+++ b/scripts/bundle-notices.test.mjs
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import test from "node:test";
+import { writeBundleNotices } from "./bundle-notices.mjs";
+
+function fixture(t) {
+	const root = mkdtempSync(join(tmpdir(), "pi-notices-"));
+	t.after(() => rmSync(root, { recursive: true, force: true }));
+	for (const path of ["packages/coding-agent/LICENSES", "packages/mcp/LICENSES", "node_modules/example/dist"]) {
+		mkdirSync(join(root, path), { recursive: true });
+	}
+	for (const path of ["packages/coding-agent/LICENSES", "packages/mcp/LICENSES"]) {
+		cpSync(resolve(import.meta.dirname, "..", path), join(root, path), { recursive: true });
+	}
+	writeFileSync(join(root, "node_modules/example/package.json"), JSON.stringify({ name: "example", version: "1.0.0", license: "MIT" }));
+	writeFileSync(join(root, "node_modules/example/dist/package.json"), '{"type":"module"}');
+	writeFileSync(join(root, "node_modules/example/dist/index.js"), "export {};");
+	return { root, metafiles: [{ inputs: { "node_modules/example/dist/index.js": {} } }], output: join(root, "notices.txt") };
+}
+
+test("module-format package.json is not a dependency root; preserve full LICENSE and NOTICE", (t) => {
+	const f = fixture(t);
+	writeFileSync(join(f.root, "node_modules/example/LICENSE"), "Exact full license text");
+	writeFileSync(join(f.root, "node_modules/example/NOTICE"), "Exact attribution");
+	writeBundleNotices(f.root, f.metafiles, f.output);
+	const output = readFileSync(f.output, "utf8");
+	assert.match(output, /example@1\.0\.0/);
+	assert.match(output, /Exact full license text/);
+	assert.match(output, /Exact attribution/);
+	assert.doesNotMatch(output, /undefined@undefined/);
+});
+
+test("unknown missing license still fails closed", (t) => {
+	const f = fixture(t);
+	assert.throws(() => writeBundleNotices(f.root, f.metafiles, f.output), /Missing bundled licenses:\nexample@1\.0\.0/);
+});
+
+test("recovered notices are exact-version and digest bound", (t) => {
+	const f = fixture(t);
+	const directory = join(f.root, "packages/coding-agent/LICENSES");
+	const text = "Recovered full license and copyright";
+	writeFileSync(join(directory, "example.txt"), text);
+	const override = { "example@1.0.0": { files: [{ file: "example.txt", sha256: createHash("sha256").update(text).digest("hex") }] } };
+	writeFileSync(join(directory, "notice-overrides.json"), JSON.stringify(override));
+	writeBundleNotices(f.root, f.metafiles, f.output);
+	assert.match(readFileSync(f.output, "utf8"), /Recovered full license and copyright/);
+	writeFileSync(join(directory, "example.txt"), "tampered");
+	assert.throws(() => writeBundleNotices(f.root, f.metafiles, f.output), /Notice digest mismatch/);
+	writeFileSync(join(dirname(join(f.root, "node_modules/example/dist")), "package.json"), '{"name":"example","version":"1.0.1"}');
+	assert.throws(() => writeBundleNotices(f.root, f.metafiles, f.output), /Missing bundled licenses/);
+});
