+#!/usr/bin/env node
+
+import { readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { produceArtifactSet } from "./package-artifacts.mjs";
+import { getPublicWorkspacePackages } from "./release-packages.mjs";
+
+// The consumer contract needs this runtime/SDK closure, not all ten public workspaces.
+const packageNames = [
+	"pi-agent-core", "pi-ai", "pi-codemode", "pi-coding-agent", "pi-mcp", "pi-telemetry", "pi-tui",
+].map((name) => `@earendil-works/${name}`);
+const repoRoot = resolve(import.meta.dirname, "..");
+for (const pkg of getPublicWorkspacePackages(join(repoRoot, "packages")).filter((pkg) => packageNames.includes(pkg.name))) {
+	const manifest = JSON.parse(readFileSync(join(pkg.directory, "package.json"), "utf8"));
+	if (pkg.version !== "1.4.0") throw new Error(`Unexpected version: ${pkg.name}@${pkg.version}`);
+	if (readFileSync(join(pkg.directory, "LICENSE"), "utf8") !== readFileSync(join(repoRoot, "LICENSE"), "utf8")) {
+		throw new Error(`Upstream license mismatch: ${pkg.name}`);
+	}
+	for (const name of Object.keys(manifest.dependencies ?? {})) {
+		if (name.startsWith("@earendil-works/") && !packageNames.includes(name)) throw new Error(`Missing internal dependency: ${name}`);
+	}
+}
+if (!process.argv[2]) throw new Error("Usage: node scripts/pack-private-preparation.mjs <new-output-directory> (build first with npm run build:offline)");
+const artifacts = produceArtifactSet({ repoRoot, outDir: process.argv[2], build: false, packageNames });
+console.log(`Private seven-package manifest: ${artifacts.manifestPath}`);
