#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NODE=${CONCOURSE_V3_NODE:-node}
if ! "$NODE" -e 'if (Number(process.versions.node.split(".")[0]) < 24) process.exit(1)' 2>/dev/null; then
  printf '%s\n' 'Concourse v3 requires Node >=24. Set CONCOURSE_V3_NODE to an explicit Node 24 executable.' >&2
  exit 1
fi
exec "$NODE" --experimental-transform-types "$ROOT/pi/concourse-v3/cli.ts" "$@"
